# ── 인증 (필수) ──────────────────────────────────────────────────────────────────
API_KEY=your-api-key-here

# ── 모델 경로 ────────────────────────────────────────────────────────────────────
# NCNN: 디렉터리 경로 (best_ncnn_model/)
# .pt:  파일 경로 (best.pt)
MAIN_MODEL_PATH=weights/yolo26m_best_ncnn_model
STATE_MODEL_PATH=weights/multihead.onnx

# ── 추론 설정 ────────────────────────────────────────────────────────────────────
DETECT_CONF=0.25            # 박스 생성 최소 신뢰도 (미만 → NOT_DETECTED)
TRUST_CONF=0.55             # 신뢰 판정 임계값 (미만 → LOW_CONFIDENCE 일반쓰레기)
IMG_SIZE=640
SUB_IMG_SIZE=224
DEVICE=cpu                  # Pi5: cpu  /  GPU 서버: 0

# ── 무게 이상 감지 ────────────────────────────────────────────────────────────────
WEIGHT_ANOMALY_ENABLED=true

# ── Spring 콜백 ──────────────────────────────────────────────────────────────────
# 미설정 시 콜백 비활성.
SPRING_CALLBACK_URL=https://oneexpo.kro.kr/api/v1/feedbackDetail/results
SPRING_TIMEOUT_SEC=3.0

# ── 결과 로깅 ────────────────────────────────────────────────────────────────────
LOG_RESULTS=true
LOG_DIR=logs
