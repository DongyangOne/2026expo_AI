# ── 인증 (필수) ──────────────────────────────────────────────────────────────────
API_KEY=your-api-key-here

# ── 모델 경로 ────────────────────────────────────────────────────────────────────
# NCNN: 디렉터리 경로 (best_ncnn_model/)
# .pt:  파일 경로 (best.pt)
MAIN_MODEL_PATH=weights/best_ncnn_model

# 다음주 활성화 예정 (파일 준비 전까지 주석 유지)
# PET_MODEL_PATH=weights/pet_cls_ncnn_model
# CAN_MODEL_PATH=weights/can_cls_ncnn_model

# ── 추론 설정 ────────────────────────────────────────────────────────────────────
DETECT_CONF=0.25            # 박스 생성 최소 신뢰도 (미만 → NOT_DETECTED)
TRUST_CONF=0.55             # 신뢰 판정 임계값 (미만 → LOW_CONFIDENCE 일반쓰레기)
IMG_SIZE=640
SUB_IMG_SIZE=224
DEVICE=cpu                  # Pi5: cpu  /  GPU 서버: 0

# ── 무게 이상 감지 ────────────────────────────────────────────────────────────────
WEIGHT_ANOMALY_ENABLED=true

# ── Spring 콜백 ──────────────────────────────────────────────────────────────────
# Spring 서버 IP/포트 맞춰서 설정. 미설정 시 콜백 비활성.
# SPRING_CALLBACK_URL=http://192.168.0.xxx:8080/api/ai/result
SPRING_TIMEOUT_SEC=3.0
