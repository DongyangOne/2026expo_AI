# ── 인증 (필수) ──────────────────────────────────────────────────────────────────
API_KEY=your-api-key-here

# ── 모델 경로 ────────────────────────────────────────────────────────────────────
# NCNN: 디렉터리 경로 (best_ncnn_model/)
# .pt:  파일 경로 (best.pt)
MAIN_MODEL_PATH=weights/yolo26m_best_ncnn_model
STATE_MODEL_PATH=weights/multihead.onnx
VERIFIER_MODEL_PATH=weights/verifier_qwen35_mnv3_v1.onnx
VERIFIER_SHADOW_ENABLED=true
VERIFIER_SHADOW_LOG_PATH=logs/verifier_shadow.jsonl
# 압착 판정을 검증기 dent 헤드로 만든다. '압착됨'으로 통과시킬 때만 확신을 요구한다.
# 실제 키오스크 crop 31건(전부 미압착) 오탐: state 16.1%, 검증기 3.2%, 검증기+0.90 0%.
VERIFIER_DENT_HEAD_ENABLED=true
VERIFIER_DENT_CONF=0.90

# conditions.has_label을 구형 state 모델 대신 검증기 label 헤드로 만든다.
# 학습 미사용 하드웨어 crop 19건: state 84.2%(라벨 놓침 2건), 검증기 100%.
VERIFIER_LABEL_HEAD_ENABLED=true

# YOLO 저신뢰(TRUST_CONF 미만)로 일반쓰레기가 될 건을 검증기가 확신하면 되살린다.
# 하드웨어 감사 35건 기준: 정답 20→27, 보류 14→4 (플라스틱 7건 전부 보류 → 5건 정답).
VERIFIER_RESCUE_ENABLED=true
VERIFIER_RESCUE_CONF=0.60

# YOLO와 crop 검증기가 갈리면 확정하지 않고 일반쓰레기로 보낸다.
# 하드웨어 감사 35건 기준: 켜면 확정 오답 7→0건, 대신 보류 3→14건.
VERIFIER_AGREEMENT_GATE_ENABLED=false
VINYL_CORRECTION_ENABLED=true
VINYL_CANDIDATE_CONF=0.10
VINYL_CANDIDATE_IOU=0.70
VINYL_CANDIDATE_RATIO=0.40
VINYL_VERIFIER_CONF=0.65
VINYL_VERIFIER_MARGIN=0.25

# ── 추론 설정 ────────────────────────────────────────────────────────────────────
DETECT_CONF=0.25            # 박스 생성 최소 신뢰도 (미만 → NOT_DETECTED)
DETECT_IOU=0.70             # NMS IoU (평가/크롭 생성과 동일하게 고정)
TRUST_CONF=0.55             # 신뢰 판정 임계값 (미만 → LOW_CONFIDENCE 일반쓰레기)
IMG_SIZE=640
SUB_IMG_SIZE=224
DEVICE=cpu                  # Pi5: cpu  /  GPU 서버: 0

# ── 무게 이상 감지 ────────────────────────────────────────────────────────────────
WEIGHT_ANOMALY_ENABLED=true

# ── Spring 콜백 ──────────────────────────────────────────────────────────────────
# 미설정 시 콜백 비활성.
SPRING_CALLBACK_URL=https://oneexpo.kro.kr/api/v1/feedback-detail/result
SPRING_TIMEOUT_SEC=3.0
SPRING_MAX_ATTEMPTS=3
SPRING_RETRY_BACKOFF_SEC=0.5

# ── 결과 로깅 ────────────────────────────────────────────────────────────────────
LOG_RESULTS=true
LOG_DIR=logs

# ── 재학습/오인식 검수용 요청 캡처 ───────────────────────────────────────────────
# logs/captures/YYYY-MM-DD/ 아래에 원본 이미지와 동일 ID의 판정 JSON을 저장.
CAPTURE_REQUESTS=true
CAPTURE_DIR=logs/captures
CAPTURE_MAX_IMAGE_BYTES=20971520
CAPTURE_RETENTION_DAYS=90
CAPTURE_MAX_STORAGE_MB=10240
